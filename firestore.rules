rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function verifiedCollege() {
      return signedIn()
        && request.auth.token.email.matches('.*@gmail[.]com$');
    }
    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function hasRole(r) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && role() == r;
    }
    function staff() { return hasRole('cafeteria') || hasRole('safety_officer') || hasRole('admin'); }

    match /users/{uid} {
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'student'
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@gmail[.]com$');
      allow read: if signedIn() && (request.auth.uid == uid || hasRole('admin'));
      allow update, delete: if hasRole('admin');
    }

    match /listings/{id} {
      allow read: if signedIn() && (
        resource.data.status == 'approved'
        || resource.data.createdBy == request.auth.uid
        || hasRole('safety_officer') || hasRole('admin')
      );
      allow create: if hasRole('cafeteria')
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'pending_review'
        && request.resource.data.quantity is int
        && request.resource.data.quantity >= 1
        && request.resource.data.quantity <= 500
        && request.resource.data.reservedQuantity == 0
        && request.resource.data.handedOverQuantity == 0
        && request.resource.data.pickupDeadline > request.time
        && request.resource.data.pickupDeadline < request.time + duration.value(7, 'd')
        && request.resource.data.allergenInfo is string
        && request.resource.data.handlingNotes is string;
      allow update: if (
        ((hasRole('safety_officer') || hasRole('admin'))
          && resource.data.status == 'pending_review'
          && resource.data.createdBy != request.auth.uid
          && request.resource.data.status in ['approved','rejected']
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status','reviewedBy','reviewNote','reviewedAt']))
        ||
        (verifiedCollege() && hasRole('student')
          && resource.data.status == 'approved'
          && request.resource.data.reservedQuantity == resource.data.reservedQuantity + 1
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['reservedQuantity','lastReservationId'])
          && request.resource.data.quantity - request.resource.data.reservedQuantity - resource.data.handedOverQuantity >= 0
          && getAfter(/databases/$(database)/documents/reservations/$(request.resource.data.lastReservationId)).data.listingId == id
          && getAfter(/databases/$(database)/documents/reservations/$(request.resource.data.lastReservationId)).data.studentUid == request.auth.uid
          && getAfter(/databases/$(database)/documents/reservations/$(request.resource.data.lastReservationId)).data.status == 'reserved')
      );
      allow delete: if hasRole('admin');
    }

    match /reservations/{id} {
      allow read: if signedIn() && (
        resource.data.studentUid == request.auth.uid
        || hasRole('cafeteria') || hasRole('admin')
      );
      allow create: if verifiedCollege()
        && hasRole('student')
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.status == 'reserved';
      allow update, delete: if false;
    }

    match /auditLogs/{id} {
      allow read: if hasRole('admin');
      allow create: if hasRole('safety_officer') || hasRole('admin');
      allow update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}