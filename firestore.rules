rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profileExists() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function roleIs(role) { return profileExists() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role; }
    function isStaff() { return roleIs('cafeteria') || roleIs('safety_officer') || roleIs('admin'); }

    // Client SDK is read-only. All mutations go through validated Cloud Functions.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || roleIs('admin'));
      allow write: if false;
    }
    match /listings/{listingId} {
      allow read: if (signedIn() && resource.data.status == 'approved')
                  || (signedIn() && resource.data.createdBy == request.auth.uid)
                  || roleIs('safety_officer') || roleIs('admin');
      allow write: if false;
    }
    match /reservations/{reservationId} {
      allow read: if signedIn() && (resource.data.studentUid == request.auth.uid
                  || roleIs('cafeteria') || roleIs('admin'));
      allow write: if false;
    }
    match /auditLogs/{id} {
      allow read: if roleIs('admin');
      allow write: if false;
    }
    match /forecasts/{id} {
      allow read: if roleIs('admin');
      allow write: if false;
    }
  }
}